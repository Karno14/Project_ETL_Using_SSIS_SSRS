      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">REPLACE(REPLACE(@[$Package::SQL_QUERY], "${STARTDATE}", @[$Package::STARTDATE]), "${ENDDATE}", @[$Package::ENDDATE])</DTS:PropertyExpression>
