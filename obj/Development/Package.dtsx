        <SQLTask:SqlTaskData
          SQLTask:Connection="{D8B5D34C-38A2-4D78-9B2F-9E09E962D77C}"
          SQLTask:SqlStatementSource="select * from (select to_char(i::date,'yyyy-mm-dd') as &quot;STARTDATE&quot;, to_char(i::date+interval '1 DAY','yyyy-mm-dd') as &quot;ENDDATE&quot;, to_char(i::date,'yyyymmdd') as filename from generate_series('2026-01-01'::date,'2026-01-10'::date, '1 day'::interval) i) a where to_char(now()::date, 'yyyy-mm-dd') = '2026-11-08'"
          SQLTask:ResultType="ResultSetType_Rowset" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::DateList" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
