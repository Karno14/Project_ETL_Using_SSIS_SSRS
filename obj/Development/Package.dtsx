      <DTS:Property
        DTS:DataType="8"
        DTS:Name="ParameterValue">select * from (select to_char(i::date,'yyyy-mm-dd') as "STARTDATE", to_char(i::date+interval '1 DAY','yyyy-mm-dd') as "ENDDATE", to_char(i::date,'yyyymmdd') as filename from generate_series('${STARTDATE}'::date,'${ENDDATE}'::date, '1 day'::interval) i) a where to_char(now()::date, 'yyyy-mm-dd') = '2026-11-08'</DTS:Property>
    </DTS:PackageParameter>
